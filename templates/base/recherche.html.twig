<form action="{{ path('app_mes_produits') }}" method="get" class="relative flex items-center group max-w-xs w-full">
    <span class="material-symbols-outlined absolute left-3 text-slate-400 group-focus-within:text-primary text-[20px] transition-colors pointer-events-none">
        search
    </span>

    <input 
        type="search" 
        name="q" 
        value="{{ searchValue|default('') }}"
        placeholder="Rechercher..." 
        class="w-full bg-slate-100/80 border-none rounded-xl py-2.5 pl-10 pr-4 text-sm font-medium text-slate-700 placeholder-slate-500 focus:ring-2 focus:ring-primary/20 focus:bg-white focus:shadow-sm transition-all outline-none"
    >

    <button type="submit" class="hidden">Rechercher</button>
</form>