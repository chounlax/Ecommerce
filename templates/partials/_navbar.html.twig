<nav class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md top-0 sticky z-50 shadow-sm dark:shadow-none">
    <div class="flex justify-between items-center w-full px-6 py-4 max-w-screen-2xl mx-auto">

        {# Logo + Navigation principale #}
        <div class="flex items-center gap-8">
            <a href="{{ path('app_home') }}" class="text-2xl font-black italic tracking-tighter text-orange-700 dark:text-orange-500 font-headline">
                TriathShare
            </a>

            <div class="hidden md:flex gap-6 items-center">
                {% set navLinks = [
                    { label: 'Swim',        route: 'app_category', params: { slug: 'swim' } },
                    { label: 'Bike',        route: 'app_category', params: { slug: 'bike' } },
                    { label: 'Run',         route: 'app_category', params: { slug: 'run' } },
                    { label: 'Training',    route: 'app_training', params: {} },
                    { label: 'Accessories', route: 'app_category', params: { slug: 'accessories' } },
                ] %}

                {% for link in navLinks %}
                    {% set isActive = app.request.attributes.get('_route') == link.route
                        and (link.params is empty or app.request.attributes.get('slug') == link.params.slug|default('')) %}
                    <a href="{{ path(link.route, link.params) }}"
                       class="font-label font-medium transition-colors
                              {{ isActive
                                 ? 'text-orange-700 dark:text-orange-500 font-bold border-b-2 border-orange-700 dark:border-orange-500 pb-1'
                                 : 'text-slate-700 dark:text-slate-300 hover:text-orange-600 dark:hover:text-orange-400' }}">
                        {{ link.label }}
                    </a>
                {% endfor %}
            </div>
        </div>

        {# Recherche + actions #}
        <div class="flex items-center gap-4">
            <form action="{{ path('app_search') }}" method="GET" class="relative hidden lg:block">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
                <input
                    type="text"
                    name="q"
                    value="{{ app.request.query.get('q') }}"
                    placeholder="Search gear..."
                    class="bg-surface-container-low border-none rounded-full py-2 pl-10 pr-4 text-sm focus:ring-2 focus:ring-primary/30 w-64 transition-all"
                />
            </form>

            <div class="flex items-center gap-2">
                <a href="{{ path('app_cart') }}"
                   class="p-2 hover:bg-slate-100/50 dark:hover:bg-slate-800/50 rounded-md transition-all cursor-pointer relative">
                    <span class="material-symbols-outlined">shopping_cart</span>
                    {# Badge panier — décommenter si vous avez une variable cart_count #}
                    {# {% if cart_count is defined and cart_count > 0 %}
                        <span class="absolute -top-1 -right-1 w-5 h-5 bg-primary text-white text-xs rounded-full flex items-center justify-center font-bold">
                            {{ cart_count }}
                        </span>
                    {% endif %} #}
                </a>

                {% if app.user %}
                    <a href="{{ path('app_profile') }}"
                       class="p-2 hover:bg-slate-100/50 dark:hover:bg-slate-800/50 rounded-md transition-all cursor-pointer">
                        <span class="material-symbols-outlined">person</span>
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}"
                       class="p-2 hover:bg-slate-100/50 dark:hover:bg-slate-800/50 rounded-md transition-all cursor-pointer">
                        <span class="material-symbols-outlined">person</span>
                    </a>
                {% endif %}
            </div>
        </div>

    </div>
</nav>
