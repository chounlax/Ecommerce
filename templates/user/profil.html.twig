{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} - Mon Profil
{% endblock %}

{% block body %}
<main class="max-w-screen-lg mx-auto px-6 py-12">
    
    <div class="mb-12 border-b border-slate-200 pb-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-center md:text-left">
            <h1 class="font-headline text-4xl md:text-5xl font-black text-on-surface tracking-tighter uppercase">
                Mon Espace
            </h1>
            <p class="text-slate-500 mt-2 font-medium">Gérez vos informations personnelles et vos préférences.</p>
        </div>
        <a href="{{ path('app_logout') }}" class="text-sm font-bold text-red-500 hover:text-red-600 transition-colors flex items-center gap-2 bg-red-50 px-5 py-3 rounded-xl shadow-sm hover:shadow-md">
            <span class="material-symbols-outlined text-base">logout</span> Se déconnecter
        </a>
    </div>

    <div class="flex flex-col md:flex-row gap-8">
        
        <aside class="w-full md:w-1/3">
            <div class="bg-slate-900 rounded-[2rem] p-8 shadow-xl text-center text-white relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-primary to-orange-400"></div>
                
                <div class="w-24 h-24 mx-auto bg-white/10 border border-white/20 text-white rounded-full flex items-center justify-center text-4xl font-black mb-6 uppercase shadow-lg backdrop-blur-sm">
                    {{ app.user.nom|first }}
                </div>
                
                <h2 class="font-headline text-2xl font-bold">{{ app.user.nom|capitalize }}</h2>
                
                <div class="mt-4 mb-8">
                    {% if "ROLE_ADMIN" in app.user.roles %}
                        <span class="bg-red-500/20 text-red-400 border border-red-500/30 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest">Administrateur</span>
                    {% elseif "ROLE_MOD" in app.user.roles %}
                        <span class="bg-primary/20 text-primary border border-primary/30 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest">Modérateur</span>
                    {% else %}
                        <span class="bg-white/10 text-slate-300 border border-white/20 px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest">Utilisateur</span>
                    {% endif %}
                </div>

                <div class="border-t border-slate-700 pt-6">
                    <p class="text-slate-400 text-sm uppercase tracking-widest text-[10px] font-bold mb-1">Membre depuis le</p>
                    <p class="text-white font-bold text-lg">{{ app.user.dateInscription|date('d/m/Y') }}</p>
                </div>
            </div>
        </aside>

        <div class="w-full md:w-2/3 space-y-6">
            
            <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100">
                <h3 class="font-headline text-xl font-bold text-slate-900 mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
                    <span class="material-symbols-outlined text-primary">badge</span>
                    Informations Personnelles
                </h3>
                
                <div class="space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 bg-slate-50 rounded-xl border border-slate-100">
                        <div class="mb-1 sm:mb-0 text-[10px] font-black uppercase tracking-widest text-slate-400">Nom complet</div>
                        <div class="font-bold text-slate-900 text-lg">{{ app.user.nom|upper }}</div>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 bg-slate-50 rounded-xl border border-slate-100">
                        <div class="mb-1 sm:mb-0 text-[10px] font-black uppercase tracking-widest text-slate-400">Adresse Email</div>
                        <div class="font-bold text-slate-900 text-lg">{{ app.user.email }}</div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <a href="{{ path('app_liste_favoris') }}" class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100 hover:border-red-200 hover:shadow-md transition-all group flex items-center gap-4">
                    <div class="w-14 h-14 bg-red-50 text-red-500 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-2xl">favorite</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-900">Mes Favoris</h4>
                        <p class="text-xs text-slate-500 mt-1">Voir ma wishlist</p>
                    </div>
                </a>
                
                <a href="{{ path('app_mes_produits') }}" class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100 hover:border-primary hover:shadow-md transition-all group flex items-center gap-4">
                    <div class="w-14 h-14 bg-primary/10 text-primary rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-2xl">shopping_bag</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-900">Boutique</h4>
                        <p class="text-xs text-slate-500 mt-1">Continuer mes achats</p>
                    </div>
                </a>
            </div>
	{# --- SECTION HISTORIQUE DES COMMANDES --- #}
<div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100 mt-8">
    <h3 class="font-headline text-xl font-bold text-slate-900 mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
        <span class="material-symbols-outlined text-primary">history</span>
        Historique de mes commandes
    </h3>

    {% if app.user.commandes is empty %}
        <div class="text-center py-10">
            <p class="text-slate-400 font-medium">Vous n'avez pas encore passé de commande.</p>
            <a href="{{ path('app_mes_produits') }}" class="text-primary font-bold text-sm hover:underline mt-2 inline-block">Commencer mes achats</a>
        </div>
    {% else %}
        <div class="space-y-6">
            {% for commande in app.user.commandes|sort((a, b) => b.dateAchat <=> a.dateAchat) %}
                <div class="border border-slate-100 rounded-2xl overflow-hidden shadow-sm">
                    {# En-tête de la commande #}
                    <div class="bg-slate-50 px-6 py-4 flex flex-col sm:flex-row justify-between items-center gap-4 border-b border-slate-100">
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Commande du</p>
                            <p class="font-bold text-slate-900">{{ commande.dateAchat|date('d/m/Y à H:i') }}</p>
                        </div>
                        <div class="text-center sm:text-right">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Total payé</p>
                            <p class="font-black text-primary text-xl">{{ commande.prixTotal|number_format(2, ',', ' ') }} €</p>
                        </div>
                    </div>

                    {# Liste des produits dans la commande #}
                    <div class="p-6">
                        <table class="w-full text-left text-sm">
                            <thead>
                                <tr class="text-slate-400 text-[10px] font-black uppercase tracking-widest">
                                    <th class="pb-4">Produit</th>
                                    <th class="pb-4 text-center">Qté</th>
                                    <th class="pb-4 text-right">Prix</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                {% for item in commande.produits %}
                                    <tr>
                                        <td class="py-3 font-bold text-slate-700">{{ item.nom }}</td>
                                        <td class="py-3 text-center text-slate-500">x{{ item.quantite }}</td>
                                        <td class="py-3 text-right font-medium text-slate-900">{{ item.total_ligne|number_format(2, ',', ' ') }} €</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
					
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
        </div>
    </div>
</main>
{% endblock %}