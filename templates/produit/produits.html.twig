{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	- Liste des Produits
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		/* Animation du cœur */
		@keyframes heartPop {
			0% {
				transform: scale(1);
			}
			50% {
				transform: scale(1.4);
			}
			100% {
				transform: scale(1);
			}
		}
		.animate-heart {
			animation: heartPop 0.3s ease-out;
			color: #ef4444 !important; /* Rouge Tailwind */
			font-variation-settings: 'FILL' 1;
		}
		.heart-btn {
			transition: all 0.2s ease;
		}
		.heart-btn:hover {
			transform: scale(1.1);
			background-color: white !important;
		}
	</style>
{% endblock %}

{% block body %}

	<main class="max-w-screen-2xl mx-auto px-6 py-12">
		<div class="flex flex-col md:flex-row gap-12">
		

			<aside class="w-full md:w-72 flex-shrink-0 space-y-10">
			{% if searchValue %}
    <div class="flex items-center gap-3 mb-8">
        <span class="text-slate-500 text-sm font-medium">Résultats pour :</span>
        <div class="flex items-center gap-2 bg-primary/10 border border-primary/20 text-primary px-4 py-1.5 rounded-full shadow-sm">
            <span class="font-bold">"{{ searchValue }}"</span>
            <a href="{{ path('app_mes_produits') }}" class="flex items-center hover:text-orange-700 transition-colors">
                <span class="material-symbols-outlined text-sm">close</span>
            </a>
        </div>
    </div>
{% endif %}
				<form
					action="{{ path('app_mes_produits') }}" method="get" id="filter-form">
					{# On garde la recherche active si elle existe #}
					<input type="hidden" name="q" value="{{ searchValue }}">
					<input type="hidden" name="sort" value="{{ currentSort }}">

					<div class="flex items-center space-x-2 text-primary mb-6">
						<span class="material-symbols-outlined text-lg">tune</span>
						<h2 class="font-headline font-bold text-lg tracking-tight uppercase">Filtres</h2>
					</div>

					<section>
						<h3 class="font-headline font-bold text-on-surface mb-4">Catégories</h3>
						<div class="space-y-2">
							{% for item in categories %}
								{% set catName = item.categorie %}
								<label class="flex items-center group cursor-pointer">
									<input name="categories[]" value="{{ catName }}" class="rounded-sm border-slate-300 text-primary focus:ring-primary/20 mr-3" type="checkbox" onchange="this.form.submit()" {% if catName in categoriesSelected %} checked {% endif %}/>
									<span class="text-sm text-on-surface-variant group-hover:text-primary transition-colors">
										{{ catName }}
									</span>
								</label>
							{% endfor %}
						</div>
					</section>

					<noscript>
						<button type="submit" class="mt-4 bg-primary text-white p-2 rounded">Filtrer</button>
					</noscript>
				</form>
			</aside>
			

			<section class="flex-1">
				
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-10 gap-4">
					<div>
						<span class="text-primary font-bold text-xs tracking-widest uppercase mb-1 block">Catalogue</span>
						<h1 class="font-headline text-4xl font-black text-on-surface tracking-tighter uppercase">Tous nos produits</h1>
					</div>

					<div class="flex items-center gap-4 w-full sm:w-auto">
						<span class="text-sm text-slate-500 whitespace-nowrap">{{ produits|length }}
							produits</span>
						<select onchange="window.location.href = this.value;" class="bg-white ...">
							<option value="{{ path('app_mes_produits', {sort: '', q: searchValue}) }}">Trier par</option>
							<option value="{{ path('app_mes_produits', {sort: 'price_asc', q: searchValue}) }}" {% if currentSort == 'price_asc' %} selected {% endif %}>
								Prix : Croissant
							</option>
							<option value="{{ path('app_mes_produits', {sort: 'price_desc', q: searchValue}) }}" {% if currentSort == 'price_desc' %} selected {% endif %}>
								Prix : Décroissant
							</option>
						</select>
					</div>
				</div>


				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
					{% for produit in produits %}

						{% set image = 'uploads/images/' ~ produit.image.nomServeur %}

						<article
							class="group relative flex flex-col h-full">
							{# IMAGE CONTAINER #}
							<div
								class="aspect-[4/5] bg-slate-100 overflow-hidden mb-6 transition-all duration-300 group-hover:bg-slate-200 relative rounded-2xl shadow-sm border border-slate-100">

								{# COEUR (FAVORIS) #}
								<a href="{{path("app_favoris",{'id':produit.id})}}">
									{% if not is_granted('IS_AUTHENTICATED_FULLY') %}
										<button class="heart-btn absolute top-4 right-4 z-20 bg-white/80 backdrop-blur-md p-2 rounded-full shadow-sm text-slate-400 hover:text-red-500 flex items-center justify-center">
											<span class="material-symbols-outlined !text-2xl transition-all">favorite</span>
										</button>
									{% else %}
										{% if produit in app.user.produit %}
											<button onclick="toggleFavorite(this)" class="heart-btn absolute top-4 right-4 z-20 bg-white/80 backdrop-blur-md p-2 rounded-full shadow-sm text-red-500 flex items-center justify-center">
												<span class="material-symbols-outlined !text-2xl transition-all animate-heart">favorite</span>
											</button>
										{% else %}
											<button onclick="toggleFavorite(this)" class="heart-btn absolute top-4 right-4 z-20 bg-white/80 backdrop-blur-md p-2 rounded-full shadow-sm text-slate-400 hover:text-red-500 flex items-center justify-center">
												<span class="material-symbols-outlined !text-2xl transition-all">favorite</span>
											</button>
										{% endif %}
									{% endif %}
								</a>

								{# BOUTON AJOUTER AU PANIER (APPARAÎT AU SURVOL) #}
								<div class="absolute inset-x-4 bottom-4 z-30 translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 ease-out">
									<a href="{{ path('app_panier_add', {id: produit.id}) }}" class="w-full bg-slate-900/90 hover:bg-primary backdrop-blur-md text-white font-bold py-4 rounded-xl shadow-xl flex items-center justify-center gap-3 group/btn">
										<span class="material-symbols-outlined text-xl group-hover/btn:scale-110 transition-transform">shopping_bag</span>
										<span class="text-[10px] uppercase tracking-[0.2em]">Ajouter au panier</span>
									</a>
								</div>

								{# IMAGE #}
								<img
								alt="{{ produit.nom }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" src="{{ asset(image) }}"/>

								{# BADGE STOCK #}
								{% if produit.stock < 2 %}
									<div class="absolute top-4 left-4">
										<span class="bg-red-600 text-white px-2 py-1 rounded text-[9px] font-black uppercase tracking-tighter shadow-lg">
											Derniers articles
										</span>
									</div>
								{% endif %}
							</div>

							{# INFOS PRODUIT #}
							<div class="space-y-2 px-1">
								<div class="flex justify-between items-start">
									<div>
										<p class="text-[10px] text-primary font-bold tracking-widest uppercase mb-1">{{ produit.marque }}</p>
										<h3 class="font-headline font-extrabold text-lg leading-tight group-hover:text-primary transition-colors">
											<a href="{{ path('app_page_produit', {id: produit.id}) }}">{{ produit.nom | capitalize }}</a>
										</h3>
									</div>
									<p class="font-headline font-black text-xl text-on-surface">{{ produit.prix }}€</p>
								</div>

								<p class="text-sm text-slate-500 line-clamp-2 leading-relaxed">
									{{ produit.description }}
								</p>

								{# ACTIONS ADMIN/MOD (PLUS DISCRETES) #}
								{% if is_granted('IS_AUTHENTICATED_FULLY')  %}
									{% if "ROLE_MOD" or "ROLE_ADMIN" in app.user.roles %}
									<div class="pt-3 flex gap-4">
										<a href="{{ path('app_modifier_produit', {id: produit.id}) }}" class="text-[10px] font-bold text-slate-400 hover:text-primary uppercase tracking-widest transition-colors">Modifier</a>
										<a href="{{ path('app_supprimer_produit', {id: produit.id}) }}" class="text-[10px] font-bold text-slate-400 hover:text-red-500 uppercase tracking-widest transition-colors">Supprimer</a>
									</div>
									{% endif %}
								{% endif %}
							</div>
						</article>

					{% endfor %}
				</div>

			</section>
		</div>
	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		function toggleFavorite(btn) {
const icon = btn.querySelector('span');

// Toggle l'animation
if (icon.classList.contains('animate-heart')) {
icon.classList.remove('animate-heart');
btn.classList.remove('text-red-500');
btn.classList.add('text-slate-400');
} else {
icon.classList.add('animate-heart');
btn.classList.add('text-red-500');
btn.classList.remove('text-slate-400');
}
}
	</script>
{% endblock %}
