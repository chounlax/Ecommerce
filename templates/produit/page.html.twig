{% extends 'base.html.twig' %}

{% block body %}
{% set image = 'uploads/images/' ~ produit.image.nomServeur %}
<div class="max-w-screen-2xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-0">
    
    <div class="lg:col-span-7 space-y-4 p-4 bg-surface-low">
        <div class="rounded-xl overflow-hidden bg-white flex justify-center p-8">
    <img src="{{ asset(image) }}" class="h-180 w-auto object-contain">
</div>
        
        </div>

    <div class="lg:col-span-5 p-8 lg:p-16 lg:sticky lg:top-20 lg:h-screen overflow-y-auto bg-white">
        
        <div class="flex items-center gap-2 text-yellow-500 mb-4">
            <span class="material-symbols-outlined">star</span> 4.8 
            <span class="text-secondary text-sm font-normal">(20 avis)</span>
        </div>

        <h1 class="font-headline text-4xl font-black italic mb-2 uppercase">{{ produit.nom }}</h1>
        <p class="text-secondary mb-8">{{ produit.description }}</p>

        

        <div class="mt-auto border-t border-surface-low pt-8">
            <div class="text-5xl font-black italic mb-2">{{ produit.prix|number_format(2, ',', ' ') }} €</div>
            <p class="text-sm text-secondary mb-6">Ou 235,14 €/mois avec financement</p>
            
            <button class="w-full kinetic-gradient text-white py-5 rounded-xl font-headline text-xl shadow-lg hover:scale-[1.02] transition-transform">
                AJOUTER AU PANIER
            </button>
        </div>
        
    </div>
</div>
{% endblock %}
