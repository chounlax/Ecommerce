{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	- Mes Favoris
{% endblock %}

{% block body %}
	<main class="max-w-screen-2xl mx-auto px-6 py-12">
		<div class="mb-12">
			<span class="text-primary font-bold text-xs tracking-widest uppercase mb-1 block text-center md:text-left">Ma Sélection</span>
			<h1 class="font-headline text-4xl md:text-5xl font-black text-on-surface tracking-tighter text-center md:text-left uppercase">
				Mes Favoris
				<span class="text-slate-300">({{ app.user.produit | length }})</span>
			</h1>
		</div>

		{% if app.user.produit | length == 0 %}
			<div class="bg-white rounded-3xl p-12 md:p-24 shadow-sm border border-slate-100 text-center flex flex-col items-center">
				<div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mb-6">
					<span class="material-symbols-outlined text-5xl text-slate-300">favorite_border</span>
				</div>
				<h2 class="font-headline text-2xl font-bold text-on-surface mb-2">Votre liste est vide</h2>
				<p class="text-slate-500 max-w-md mx-auto mb-8 text-lg">
					Vous n'avez pas encore de coup de cœur ? Parcourez notre catalogue pour trouver l'équipement idéal.
				</p>
				<a href="{{ path('app_mes_produits') }}" class="bg-primary hover:bg-primary-dim text-white font-bold py-4 px-10 rounded-2xl shadow-lg shadow-orange-900/20 transition-all transform hover:-translate-y-1">
					Découvrir le catalogue
				</a>
			</div>
		{% else %}
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-8 gap-y-12">
				{% for produit in app.user.produit %}
					{% set image = 'uploads/images/' ~ produit.image.nomServeur %}

					<article class="group relative bg-white p-4 rounded-[2rem] border border-slate-50 shadow-sm hover:shadow-xl hover:shadow-slate-200/50 transition-all duration-500">

						<div class="aspect-square bg-slate-50 overflow-hidden relative rounded-[1.5rem] mb-6">
							<img alt="{{ produit.nom }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" src="{{ asset(image) }}"/>

							<a href="{{path("app_favoris",{'id':produit.id})}}">

								{% if produit in app.user.produit %}
									<button onclick="toggleFavorite(this)" class="heart-btn absolute top-4 right-4 z-20 bg-white/80 backdrop-blur-md p-2 rounded-full shadow-sm text-red-500 flex items-center justify-center">
										<span class="material-symbols-outlined !text-2xl transition-all animate-heart">favorite</span>
									</button>
								{% else %}
									<button onclick="toggleFavorite(this)" class="heart-btn absolute top-4 right-4 z-20 bg-white/80 backdrop-blur-md p-2 rounded-full shadow-sm text-slate-400 hover:text-red-500 flex items-center justify-center">
										<span class="material-symbols-outlined !text-2xl transition-all">favorite</span>
									</button>
								{% endif %}

							</a>

							{% if produit.stock < 5 %}
								<div class="absolute bottom-3 left-3">
									<span class="bg-red-100/90 backdrop-blur-md text-red-700 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-tighter">
										Plus que
										{{ produit.stock }}
									</span>
								</div>
							{% endif %}
						</div>

						<div class="px-2 pb-2">
							<div class="flex justify-between items-start mb-2">
								<div>
									<p class="text-[10px] text-primary font-bold tracking-widest uppercase mb-1">{{ produit.marque }}</p>
									<h3 class="font-headline font-extrabold text-lg leading-tight text-on-surface group-hover:text-primary transition-colors">
										{{ produit.nom | capitalize }}
									</h3>
								</div>
								<p class="font-headline font-black text-xl text-on-surface">{{ produit.prix }}€</p>
							</div>

							<div class="mt-6 flex gap-2">
								<div class="absolute inset-x-4 bottom-4 z-30 translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 ease-out">
									<a href="{{ path('app_panier_add', {id: produit.id}) }}" class="w-full bg-slate-900/90 hover:bg-primary backdrop-blur-md text-white font-bold py-4 rounded-xl shadow-xl flex items-center justify-center gap-3 group/btn">
										<span class="material-symbols-outlined text-xl group-hover/btn:scale-110 transition-transform">shopping_bag</span>
										<span class="text-[10px] uppercase tracking-[0.2em]">Ajouter au panier</span>
									</a>
								</div>
								
							</div>
						</div>
					</article>
				{% endfor %}
			</div>

			<div class="mt-24 p-12 bg-orange-50 rounded-[3rem] border border-orange-100 flex flex-col md:flex-row items-center justify-between gap-8">
				<div class="max-w-xl text-center md:text-left">
					<h3 class="font-headline font-black text-2xl text-orange-900 mb-2">Prêt pour votre prochain défi ?</h3>
					<p class="text-orange-800/70">Finalisez votre commande maintenant pour recevoir votre équipement avant votre prochaine compétition.</p>
				</div>
				<a href="{{ path('app_liste_favoris') }}" class="bg-white text-orange-700 font-black py-4 px-8 rounded-2xl shadow-sm hover:shadow-md transition-all flex items-center gap-3">
					Voir mon panier
					<span class="material-symbols-outlined">chevron_right</span>
				</a>
			</div>
		{% endif %}
	</main>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		function toggleFavorite(btn) {
const icon = btn.querySelector('span');

// Toggle l'animation
if (icon.classList.contains('animate-heart')) {
icon.classList.remove('animate-heart');
btn.classList.remove('text-red-500');
btn.classList.add('text-slate-400');
} else {
icon.classList.add('animate-heart');
btn.classList.add('text-red-500');
btn.classList.remove('text-slate-400');
}
}
	</script>
{% endblock %}
