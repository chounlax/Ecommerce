{% extends 'base.html.twig' %}

{% block body %}
<main class="min-h-screen bg-slate-50 py-12 px-6">
    <div class="max-w-2xl mx-auto">
        
        <h1 class="font-headline text-3xl font-black text-slate-900 mb-8 uppercase tracking-tight">
            Gestion des <span class="text-primary">Fichiers</span>
        </h1>

        <div class="bg-white rounded-[2.5rem] p-8 shadow-xl border border-slate-100">
            {{ form_start(form) }}
                
                {# ZONE D'UPLOAD PERSONNALISÉE #}
                <div class="mb-8">
                    <label for="{{ form.fichier.vars.id }}" class="group relative flex flex-col items-center justify-center w-full h-48 border-2 border-dashed border-slate-200 rounded-[2rem] bg-slate-50 hover:bg-white hover:border-primary transition-all cursor-pointer overflow-hidden">
                        
                        <div class="flex flex-col items-center justify-center pt-5 pb-6">
                            <span class="material-symbols-outlined text-4xl text-slate-300 group-hover:text-primary group-hover:scale-110 transition-all mb-2">cloud_upload</span>
                            <p class="text-sm text-slate-500 font-bold tracking-wide">Cliquez pour téléverser</p>
                            <p class="text-xs text-slate-400 mt-1">PNG, JPG ou WEBP (max. 20Mo)</p>
                        </div>

                        {# L'input réel est caché mais fonctionnel #}
                        {{ form_widget(form.fichier) }}
                    </label>
                    {{ form_errors(form.fichier) }}
                </div>

                {# SÉLECTEUR USER #}
                <div class="space-y-2 mb-8">
                    <label class="text-[10px] font-black uppercase tracking-widest text-slate-400 ml-4">Utilisateur associé</label>
                    <div class="relative">
                        {{ form_widget(form.user, {'attr': {'class': 'w-full bg-slate-50 border-none rounded-2xl py-4 px-6 text-slate-700 font-bold focus:ring-2 focus:ring-primary/20 appearance-none'}}) }}
                        <span class="material-symbols-outlined absolute right-4 top-4 text-slate-400 pointer-events-none">expand_more</span>
                    </div>
                </div>

                {# BOUTON VALIDER #}
                <button type="submit" class="w-full bg-slate-900 hover:bg-primary text-white font-black py-5 rounded-2xl shadow-lg transition-all flex items-center justify-center gap-3 uppercase tracking-widest text-sm">
                    Envoyer le fichier
                    <span class="material-symbols-outlined text-sm">send</span>
                </button>

            {{ form_end(form) }}
        </div>
    </div>
</main>

{# Petit script pour afficher le nom du fichier une fois choisi #}
<script>
    document.querySelector('input[type="file"]').onchange = function() {
        const fileName = this.files[0].name;
        const label = this.closest('label').querySelector('p.text-sm');
        label.innerText = "Fichier sélectionné : " + fileName;
        label.classList.add('text-primary');
    };
</script>
{% endblock %}