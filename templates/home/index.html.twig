{% extends 'base.html.twig' %}

{% block title %}TriathShare — Professional Triathlon Gear{% endblock %}

{% block body %}

{# ═══════════════════════════════════════════
   HERO
   Variables attendues : hero_image (string, URL de l'image)
   ═══════════════════════════════════════════ #}
<section class="relative h-[870px] flex items-center overflow-hidden bg-on-surface">
    <div class="absolute inset-0 z-0">
        <img
            src="{{ hero_image|default(asset('images/hero/triathlete.jpg')) }}"
            alt="Triathlete in competition"
            class="w-full h-full object-cover opacity-60"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-on-surface via-on-surface/40 to-transparent"></div>
    </div>

    <div class="container mx-auto px-8 relative z-10">
        <div class="max-w-3xl">
            <span class="text-primary font-bold tracking-widest uppercase mb-4 block font-label">Precision in Motion</span>
            <h1 class="font-headline text-white text-6xl md:text-8xl font-black leading-none tracking-tighter mb-8 italic">
                PUSH BEYOND <br/> THE <span class="text-primary-fixed">LIMITS</span>
            </h1>
            <p class="text-surface-variant text-lg md:text-xl max-w-xl mb-10 leading-relaxed font-body">
                Professional-grade gear curated for the modern triathlete. From elite wetsuits to aero-optimized frames, we equip your pursuit of excellence.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="{{ path('app_shop') }}"
                   class="kinetic-gradient text-on-primary px-8 py-4 rounded-md font-bold text-lg shadow-lg hover:brightness-110 transition-all flex items-center gap-2">
                    Shop Collection
                    <span class="material-symbols-outlined">trending_flat</span>
                </a>
                <a href="{{ path('app_training') }}"
                   class="bg-surface-container-highest/20 backdrop-blur-md text-white px-8 py-4 rounded-md font-bold text-lg hover:bg-surface-container-highest/30 transition-all">
                    View Training Plans
                </a>
            </div>
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════
   CATEGORIES BENTO
   Variables attendues : categories (array of { slug, label, leg_label, description, image, tags, link_label })
   ═══════════════════════════════════════════ #}
<section class="py-24 px-8 max-w-screen-2xl mx-auto">
    <div class="mb-16">
        <span class="text-primary font-bold font-label">Gear Categories</span>
        <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface mt-2">Engineered for Every Leg</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 h-full md:h-[600px]">

        {# Swim — colonne 4 #}
        {% set swim = categories|filter(c => c.slug == 'swim')|first %}
        <div class="md:col-span-4 group relative overflow-hidden rounded-xl bg-surface-container-low transition-all duration-500">
            <img
                src="{{ swim.image|default(asset('images/categories/swim.jpg')) }}"
                alt="{{ swim.label|default('Swim') }}"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-on-surface to-transparent opacity-80"></div>
            <div class="absolute bottom-0 p-8 w-full">
                <span class="text-tertiary-fixed font-bold tracking-widest text-xs uppercase mb-2 block">Leg One</span>
                <h3 class="font-headline text-3xl font-bold text-white mb-4">Swim</h3>
                <ul class="text-surface-variant mb-6 space-y-1">
                    {% for tag in swim.tags|default(['High-compression Wetsuits', 'Hydrodynamic Goggles', 'Performance Caps']) %}
                        <li>{{ tag }}</li>
                    {% endfor %}
                </ul>
                <a href="{{ path('app_category', { slug: 'swim' }) }}" class="text-primary-fixed font-bold flex items-center gap-2 group/link">
                    Explore Swim <span class="material-symbols-outlined group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
                </a>
            </div>
        </div>

        {# Bike — colonne 8 #}
        {% set bike = categories|filter(c => c.slug == 'bike')|first %}
        <div class="md:col-span-8 group relative overflow-hidden rounded-xl bg-surface-container-low transition-all duration-500">
            <img
                src="{{ bike.image|default(asset('images/categories/bike.jpg')) }}"
                alt="{{ bike.label|default('Bike') }}"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-on-surface via-transparent to-transparent opacity-80"></div>
            <div class="absolute bottom-0 p-8">
                <span class="text-primary-fixed font-bold tracking-widest text-xs uppercase mb-2 block">Leg Two</span>
                <h3 class="font-headline text-4xl font-bold text-white mb-2">Bike</h3>
                <p class="text-surface-variant max-w-md mb-6 font-body">
                    {{ bike.description|default('Dominate the asphalt with precision carbon engineering and aerodynamic excellence.') }}
                </p>
                <div class="flex gap-4 flex-wrap">
                    {% for tag in bike.tags|default(['Aero Frames', 'Carbon Wheels', 'Tech Helmets']) %}
                        <span class="bg-white/10 backdrop-blur-sm text-white px-4 py-1 rounded-full text-sm">{{ tag }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Run — pleine largeur #}
        {% set run = categories|filter(c => c.slug == 'run')|first %}
        <div class="md:col-span-12 group relative overflow-hidden rounded-xl bg-surface-container-low h-80 transition-all duration-500">
            <img
                src="{{ run.image|default(asset('images/categories/run.jpg')) }}"
                alt="{{ run.label|default('Run') }}"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-on-surface via-on-surface/50 to-transparent opacity-90"></div>
            <div class="absolute inset-0 flex items-center p-12">
                <div class="max-w-md">
                    <span class="text-orange-500 font-bold tracking-widest text-xs uppercase mb-2 block">Leg Three</span>
                    <h3 class="font-headline text-4xl font-bold text-white mb-4">Run</h3>
                    <p class="text-surface-variant mb-6 font-body">
                        {{ run.description|default('Energy return redefined. Carbon-plated speed for the final push to the podium.') }}
                    </p>
                    <a href="{{ path('app_category', { slug: 'run' }) }}"
                       class="inline-block bg-white text-on-surface px-6 py-2 rounded-md font-bold hover:bg-primary-fixed transition-colors">
                        Shop Shoes
                    </a>
                </div>
            </div>
        </div>

    </div>
</section>

{# ═══════════════════════════════════════════
   TRENDING PRODUCTS
   Variables attendues : trending_products (array of Product entities)
   Propriétés : name, price, description, badge, image, slug
   ═══════════════════════════════════════════ #}
<section class="bg-surface-container-low py-24">
    <div class="container mx-auto px-8">

        <div class="flex justify-between items-end mb-16">
            <div>
                <span class="text-primary font-bold font-label">Gear Lab</span>
                <h2 class="font-headline text-4xl font-extrabold text-on-surface mt-2">Trending This Week</h2>
            </div>
            <div class="hidden md:flex gap-4">
                <button class="w-12 h-12 rounded-full flex items-center justify-center border border-outline-variant hover:bg-white transition-all">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <button class="w-12 h-12 rounded-full flex items-center justify-center bg-on-surface text-white hover:bg-primary transition-all">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {% for product in trending_products %}
                <div class="group bg-surface-container-lowest p-4 rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
                    <div class="relative overflow-hidden rounded-lg mb-6 aspect-square bg-surface">
                        <img
                            src="{{ product.image|default(asset('images/products/placeholder.jpg')) }}"
                            alt="{{ product.name }}"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        />
                        {% if product.badge is defined and product.badge %}
                            <div class="absolute top-3 {% if loop.index is odd %}left-3{% else %}right-3{% endif %}">
                                <span class="{% if loop.index is odd %}bg-tertiary-container text-on-tertiary-container{% else %}bg-primary text-on-primary{% endif %} text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-widest">
                                    {{ product.badge }}
                                </span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="flex-grow">
                        <div class="flex justify-between items-start mb-2">
                            <h4 class="font-headline font-bold text-on-surface">{{ product.name }}</h4>
                            <span class="text-primary font-bold">${{ product.price|number_format(2) }}</span>
                        </div>
                        <p class="text-on-surface-variant text-sm font-body mb-4">{{ product.description }}</p>
                    </div>

                    <form action="{{ path('app_cart_add', { id: product.id }) }}" method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}"/>
                        <button type="submit"
                                class="w-full py-3 bg-surface-container-high text-on-surface font-bold rounded-md group-hover:bg-primary group-hover:text-white transition-all">
                            Add to Cart
                        </button>
                    </form>
                </div>
            {% else %}
                <p class="col-span-4 text-center text-outline py-12">No trending products at the moment.</p>
            {% endfor %}
        </div>

    </div>
</section>

{# ═══════════════════════════════════════════
   TESTIMONIALS
   Variables attendues : testimonial (object { quote, author_name, author_title, author_image })
                         athletes_count (int)
                         finish_image (string)
   ═══════════════════════════════════════════ #}
<section class="py-24 px-8 overflow-hidden">
    <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

            <div class="relative">
                <div class="absolute -top-12 -left-12 w-64 h-64 bg-primary-container/20 rounded-full blur-3xl"></div>
                <div class="relative z-10 border-l-4 border-primary pl-10">
                    <span class="text-primary font-bold tracking-widest uppercase block mb-4 font-label">Elite Voice</span>
                    <h2 class="font-headline text-5xl font-black text-on-surface mb-8 italic leading-tight">
                        "THE DIFFERENCE <br/> BETWEEN FINISHING <br/> AND WINNING."
                    </h2>

                    {% if testimonial is defined and testimonial %}
                        <div class="p-8 bg-surface-container-lowest rounded-xl shadow-md">
                            <p class="text-lg font-body text-on-surface-variant italic mb-6">
                                "{{ testimonial.quote }}"
                            </p>
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full bg-slate-200 overflow-hidden">
                                    <img
                                        src="{{ testimonial.author_image|default(asset('images/athletes/placeholder.jpg')) }}"
                                        alt="{{ testimonial.author_name }}"
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                                <div>
                                    <h4 class="font-bold text-on-surface">{{ testimonial.author_name }}</h4>
                                    <p class="text-xs text-outline font-label uppercase">{{ testimonial.author_title }}</p>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="relative h-[500px] hidden lg:block">
                <img
                    src="{{ finish_image|default(asset('images/hero/finish-line.jpg')) }}"
                    alt="Athlete crossing the finish line"
                    class="w-full h-full object-cover rounded-xl"
                />
                <div class="absolute -bottom-6 -right-6 kinetic-gradient p-10 rounded-xl text-white shadow-2xl">
                    <div class="text-4xl font-black font-headline mb-1">{{ athletes_count|default('2,500') }}+</div>
                    <div class="text-sm font-label uppercase tracking-widest opacity-80">Elite Athletes Equipped</div>
                </div>
            </div>

        </div>
    </div>
</section>

{% endblock %}
