{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Connectez-vous{% endblock %}

{% block body %}
<main class="min-h-[70vh] flex flex-col justify-center py-12 px-6 sm:px-6 lg:px-8 bg-slate-50/50">
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center mb-8">
        <span class="text-primary font-bold text-xs tracking-widest uppercase mb-2 block">Accès Membre</span>
        <h1 class="font-headline text-4xl font-black text-on-surface tracking-tighter uppercase">Connectez-vous</h1>
    </div>

    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-6 sm:px-10 rounded-[2rem] shadow-sm border border-slate-100 relative overflow-hidden">
            
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-orange-400"></div>

            <form method="post" class="space-y-6">
                {% if error %}
                    <div class="bg-red-50 text-red-500 text-sm p-4 rounded-xl flex items-center gap-2 font-medium">
                        <span class="material-symbols-outlined text-base">error</span>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="bg-slate-50 text-slate-600 text-sm p-4 rounded-xl mb-6">
                        Vous êtes connecté en tant que <span class="font-bold">{{ app.user.userIdentifier }}</span>. 
                        <a href="{{ path('app_logout') }}" class="text-primary font-bold hover:underline ml-1">Déconnexion</a>
                    </div>
                {% endif %}

                <div>
                    <label for="inputEmail" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2 ml-1">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="w-full bg-slate-50 border-slate-200 rounded-xl focus:ring-primary focus:border-primary text-slate-700 px-4 py-3" autocomplete="email" required autofocus>
                </div>

                <div>
                    <label for="inputPassword" class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2 ml-1">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" class="w-full bg-slate-50 border-slate-200 rounded-xl focus:ring-primary focus:border-primary text-slate-700 px-4 py-3" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="pt-2">
                    <button class="w-full bg-slate-900 hover:bg-primary text-white font-bold py-4 rounded-xl shadow-lg shadow-slate-900/20 transition-all uppercase tracking-widest text-sm flex justify-center items-center gap-2" type="submit">
                        Se connecter
                        <span class="material-symbols-outlined text-sm">login</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>
{% endblock %}