		{# Colonne 2 : Navigation #}
		<div>
			<h4 class="text-xs font-black mb-6 text-slate-500 uppercase tracking-[0.2em]">Navigation</h4>
			<ul class="space-y-4 text-sm font-bold">
				<li>
					<a href="{{ path('app_accueil') }}" class="text-slate-400 hover:text-primary transition-colors flex items-center gap-2">
						<span class="w-1 h-1 bg-primary rounded-full"></span>
						Accueil
					</a>
				</li>
				<li>
					<a href="{{ path('app_mes_produits') }}" class="text-slate-400 hover:text-primary transition-colors flex items-center gap-2">
