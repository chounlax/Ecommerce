<!DOCTYPE html>
<html class="light" lang="fr">
	<head>
		<meta charset="utf-8"/>
		<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
		<title>
			{% block title %}TriathShare
			{% endblock %}
		</title>

		{# Polices et Icones #}
		<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
		<link
		href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

		{# Tailwind CSS #}
		<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
		<script>
			tailwind.config = {
darkMode: "class",
theme: {
extend: {
colors: {
"primary": "#a93000",
"primary-dim": "#942900",
"on-surface": "#212f43",
"surface-container-low": "#ebf1ff",
"primary-fixed": "#ff784d",
"surface-variant": "#cadeff"
},
fontFamily: {
"headline": ["Lexend"],
"body": ["Inter"]
}
}
}
}
		</script>
		<style>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
				vertical-align: middle;
			}
			.kinetic-gradient {
				background: linear-gradient(135deg, #a93000 0%, #ff784d 100%);
			}
		</style>

		{% block stylesheets %}{% endblock %}
	</head>
	<body class="bg-slate-50 font-body text-on-surface antialiased">
		<nav class="bg-white/90 backdrop-blur-md sticky top-0 z-50 shadow-sm relative">
			<div class="flex justify-between items-center w-full px-6 py-4 max-w-screen-2xl mx-auto">

				<div class="flex items-center gap-8">
					<a href="{{ path('app_accueil') }}" class="text-2xl font-black italic tracking-tighter text-orange-700 font-headline">TriathShare</a>

					<div class="hidden lg:flex gap-6 items-center">
						{% if is_granted('ROLE_MOD') or is_granted('ROLE_ADMIN') %}
							{# Conteneur du Dropdown avec Alpine.js pour l'ouverture/fermeture #}
							<div
								class="relative" x-data="{ open: false }">
								{# Bouton déclencheur #}
								<button @click="open = !open" @click.away="open = false" class="flex items-center gap-2 text-slate-700 font-bold hover:text-primary transition-colors uppercase tracking-widest text-xs outline-none">
									Administration
									<span class="material-symbols-outlined transition-transform duration-200" :class="open ? 'rotate-180' : ''">expand_more</span>
								</button>

								{# Liste des liens #}
								<div x-show="open" x-transition:enter="transition ease-out duration-100" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" class="absolute left-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl border border-slate-100 py-3 z-50 origin-top-left">

									<div class="px-4 py-2 border-b border-slate-50 mb-2">
										<p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Gestion Boutique</p>
									</div>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_produit') }}">
										<span class="material-symbols-outlined text-base">add_box</span>
										Produits
									</a>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_fichier') }}">
										<span class="material-symbols-outlined text-base">upload_file</span>
										Fichiers
									</a>
									{% if is_granted('ROLE_ADMIN') %}
									<div class="px-4 py-2 border-b border-slate-50 my-2">
										<p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Système</p>
									</div>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_admin_users') }}">
										<span class="material-symbols-outlined text-base">group</span>
										Utilisateurs
									</a>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_admin_mcd') }}">
										<span class="material-symbols-outlined text-base">schema</span>
										Structure BDD
									</a>
									{% endif %}
								</div>
							</div>
						{% endif %}
						<a class="text-slate-700 font-medium hover:text-orange-600 transition-colors" href="{{ path('app_mes_produits') }}">Produits</a>

						<a class="text-slate-700 font-medium hover:text-orange-600 transition-colors whitespace-nowrap" href="{{ path('app_apropos') }}">À Propos</a>

						<div class="flex-1 max-w-md ml-4">
							{{ render(controller('App\\Controller\\BaseController::recherche')) }}
						</div>


					</div>
				</div>

				<div class="flex items-center gap-4">

					<div class="hidden lg:flex items-center gap-2">
						{% if not is_granted('IS_AUTHENTICATED_FULLY') %}
							<a href="{{ path('app_login') }}" class="text-sm font-bold px-4 py-2 hover:bg-slate-100 rounded-md">Connexion</a>
							<a href="{{ path('app_register') }}" class="bg-primary text-white text-sm font-bold px-4 py-2 rounded-md hover:bg-primary-dim transition-all">S'inscrire</a>
						{% else %}

							<a href="{{ path('app_liste_favoris') }}" class="p-2 text-slate-600 hover:text-red-500 hover:bg-red-50 rounded-full transition-all" title="Mes Favoris">
								<span class="material-symbols-outlined">favorite</span>
							</a>
							<a href="{{ path('app_panier') }}" class="p-2 text-slate-600 hover:text-primary hover:bg-orange-50 rounded-full transition-all relative" title="Mon Panier">
								<span class="material-symbols-outlined">shopping_cart</span>
								{# Optionnel : Petit badge si le panier n'est pas vide #}
								{#{{ app.user.panier.Ajouters |length }}#}
								{% set total = 0 %}
								{% if app.user.panier != null %}
									{% for ajouter in app.user.panier.ajouters %}
										{% set total = total + ajouter.quantite %}
									{% endfor %}
									{% if total > 0 %}

										{% if total > 9 %}
											<span class="absolute top-1 right-1 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-white shadow-sm">9+</span>
										{% else %}
											<span class="absolute top-1 right-1 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-white shadow-sm">{{total}}</span>
										{% endif %}
									{% endif %}
								{% endif %}
							</span>
						</a>
						<a href="{{ path('app_profil') }}" class="p-2 text-slate-600 hover:text-primary hover:bg-slate-100 rounded-full transition-all" title="Mon Profil">
							<span class="material-symbols-outlined">person</span>
						</a>
						<a href="{{ path('app_logout') }}" class="p-2 hover:bg-red-50 text-red-600 rounded-md transition-all" title="Se déconnecter">
							<span class="material-symbols-outlined">logout</span>
						</a>
					{% endif %}
				</div>

				<button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-700 hover:text-primary transition-colors focus:outline-none">
					<span class="material-symbols-outlined text-3xl">menu</span>
				</button>
			</div>
		</div>

		<div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-white border-t border-slate-100 shadow-lg lg:hidden flex-col">

			<div class="flex flex-col px-6 py-4 space-y-4">
				<div class="flex-1 max-w-md ml-4">
					{{ render(controller('App\\Controller\\BaseController::recherche')) }}
				</div>
				{% if is_granted('ROLE_MOD') or is_granted('ROLE_ADMIN') %}
							{# Conteneur du Dropdown avec Alpine.js pour l'ouverture/fermeture #}
							<div
								class="relative" x-data="{ open: false }">
								{# Bouton déclencheur #}
								<button @click="open = !open" @click.away="open = false" class="flex items-center gap-2 text-slate-700 font-bold hover:text-primary transition-colors uppercase tracking-widest text-xs outline-none">
									Administration
									<span class="material-symbols-outlined transition-transform duration-200" :class="open ? 'rotate-180' : ''">expand_more</span>
								</button>

								{# Liste des liens #}
								<div x-show="open" x-transition:enter="transition ease-out duration-100" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" class="absolute left-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl border border-slate-100 py-3 z-50 origin-top-left">

									<div class="px-4 py-2 border-b border-slate-50 mb-2">
										<p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Gestion Boutique</p>
									</div>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_produit') }}">
										<span class="material-symbols-outlined text-base">add_box</span>
										Produits
									</a>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_fichier') }}">
										<span class="material-symbols-outlined text-base">upload_file</span>
										Fichiers
									</a>
									{% if is_granted('ROLE_ADMIN') %}

									<div class="px-4 py-2 border-b border-slate-50 my-2">
										<p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Système</p>
									</div>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_admin_users') }}">
										<span class="material-symbols-outlined text-base">group</span>
										Utilisateurs
									</a>

									<a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-primary transition-all" href="{{ path('app_admin_mcd') }}">
										<span class="material-symbols-outlined text-base">schema</span>
										Structure BDD
									</a>
									{% endif %}
								</div>
							</div>
						{% endif %}
				<a class="text-slate-700 font-medium hover:text-primary" href="{{ path('app_mes_produits') }}">Produits</a>
				<a class="text-slate-700 font-medium hover:text-primary" href="{{ path('app_apropos') }}">À Propos</a>

				<hr class="border-slate-200">

				{% if not is_granted('IS_AUTHENTICATED_FULLY') %}
					<a href="{{ path('app_login') }}" class="text-slate-700 font-bold hover:text-primary">Connexion</a>
					<a href="{{ path('app_register') }}" class="text-primary font-bold">Inscription</a>
				{% else %}
					<div class="grid grid-cols-3 gap-4 pt-4 border-t border-slate-100 text-center">
						<a href="{{ path('app_liste_favoris') }}" class="flex flex-col items-center gap-1 text-slate-600">
							<span class="material-symbols-outlined p-2 bg-slate-50 rounded-full">favorite</span>
							<span class="text-[10px] font-bold uppercase">Favoris</span>
						</a>
						<a href="{{ path('app_panier') }}" class="flex flex-col items-center gap-1 text-slate-600">
							<span class="material-symbols-outlined p-2 bg-slate-50 rounded-full">shopping_cart</span>
							<span class="text-[10px] font-bold uppercase">Panier</span>
						</a>
						<a href="{{ path('app_profil') }}" class="flex flex-col items-center gap-1 text-slate-600">
							<span class="material-symbols-outlined p-2 bg-slate-50 rounded-full">person</span>
							<span class="text-[10px] font-bold uppercase">Profil</span>
						</a>
					</div>
					<a href="{{ path('app_logout') }}" class="text-red-500 font-bold text-sm pt-4 flex items-center gap-2">
						<span class="material-symbols-outlined text-sm">logout</span>
						Se déconnecter
					</a>
				{% endif %}
			</div>
		</div>
	</body>
</html></nav>{# Flash Messages #}{% for message in app.flashes('notice') %}
<div class="max-w-screen-2xl mx-auto mt-4 px-6">
	<div class="bg-orange-100 border-l-4 border-orange-500 text-orange-700 p-4 shadow-sm" role="alert">
		{{ message }}
	</div>
</div>{% endfor %}<main>
{% block body %}{% endblock %}</main><footer class="bg-slate-900 text-white mt-24 border-t-4 border-primary">
<div class="max-w-screen-2xl mx-auto px-8 py-20">
	<div
		class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">

		{# Colonne 1 : Identité #}
		<div class="md:col-span-1">
			<div class="text-3xl font-black italic mb-6 font-headline uppercase tracking-tighter text-white">
				Triath<span class="text-primary italic">Sport</span>
			</div>
			<p class="text-slate-400 text-sm leading-relaxed max-w-xs">
				L'équipement d'élite pour la natation, le cyclisme et la course à pied. Repoussez vos limites avec TriathSport.
			</p>
			<div
				class="flex gap-4 mt-6">
				{# Petits cercles réseaux sociaux #}
				<div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white transition-colors cursor-pointer">
					<span class="material-symbols-outlined text-sm">share</span>
				</div>
				<div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white transition-colors cursor-pointer">
